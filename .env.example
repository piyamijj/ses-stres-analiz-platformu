# Bu dosya bir şablondur. Gerçek değerleri buraya YAZMAYIN.
# Kopyalayıp ".env.local" adıyla kaydedin ve gerçek anahtarları oraya girin.
# ".env.local" .gitignore içinde tanımlıdır ve asla commit edilmez.

# Groq API anahtar HAVUZU (ücretsiz katman, kota sınırlı) — Modül 03'ün
# kelime bazlı zaman damgalı transkripsiyonu için kullanılır (whisper-large-v3-turbo).
# src/app/api/transkript/route.ts, bu 5 anahtar arasında round-robin + 429
# (rate limit) durumunda otomatik geçiş yapan bir rotasyon uygular
# (bkz. src/lib/ai/anahtarRotasyonu.ts). Tümünü doldurmanız gerekmez; en az 1
# tanesi yeterlidir ama birden fazlası kota dayanıklılığı sağlar.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Gemini API anahtar HAVUZU (ücretsiz katman, kota sınırlı) — ileride Modül 03'ün
# dil/duygu yorumlama katmanında kullanılmak üzere hazır tutulur (aynı rotasyon
# mantığı src/lib/ai/ortamAnahtarlari.ts üzerinden okunur, henüz aktif çağrı
# yapılmıyor).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# Capacitor/Android statik export derlemesinde, paketlenmiş uygulamanın
# /api/transkript uç noktasına hangi mutlak adresten istek atacağını belirler
# (bkz. src/lib/config.ts). Web derlemesinde (Vercel) BOŞ bırakılmalıdır —
# göreli (same-origin) istek kullanılır.
NEXT_PUBLIC_API_BASE_URL=

# Vercel dağıtım token'ı — yalnızca CI/CD otomasyonu için gerekir, yerel
# geliştirmede gerekmez
VERCEL_TOKEN=